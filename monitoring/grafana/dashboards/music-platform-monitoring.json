{
  "uid": "music-platform-monitoring",
  "title": "Monitoring Stack (Prometheus / Loki / Alloy)",
  "tags": [
    "music-platform",
    "ops",
    "monitoring",
    "prometheus"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
