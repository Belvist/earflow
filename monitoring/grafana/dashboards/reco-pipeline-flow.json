{
  "uid": "reco-pipeline-flow",
  "title": "Recommendations Pipeline Flow",
  "tags": [
    "music-platform",
    "reco",
    "flow",
    "prometheus"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "API Gateway → recommendations-service (req/s)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(reco_http_requests_total{route=~\"^(/api/recommendations)?/(init|next|infinite|refresh|feedback|batch-complete|similar|radio|playback-rate|debug/explain)$\"}[5m])) or on() vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 2,
        "h": 6
      },
      "options": {
        "mode": "markdown",
        "content": "# →\n\nFeedback events\n"
      }
    },
    {
      "type": "stat",
      "title": "recommendations-service → Redis Stream (feedback req/s)",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(reco_http_requests_total{route=~\"^(/api/recommendations)?/(feedback|batch-complete)$\"}[5m])) or on() vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 2,
        "h": 6
      },
      "options": {
        "mode": "markdown",
        "content": "# →\n\nConsumer\n"
      }
    },
    {
