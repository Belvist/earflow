      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(reco_feedback_events_processed_total{status=\"success\"}[5m]))"
