{
    "extends": [
        "react-app"
    ],
    "rules": {
        "no-unused-vars": [
            "warn",
            {
                "varsIgnorePattern": "^_",
                "argsIgnorePattern": "^_"
            }
        ],
        "react-hooks/exhaustive-deps": "warn",
        "import/no-anonymous-default-export": "off",
        "no-control-regex": "off"
    }
}