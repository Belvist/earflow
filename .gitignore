# ────────────────────────────────────────────────────────────────
# PROJECT SPECIFIC
# ────────────────────────────────────────────────────────────────
# VPS runtime / local-only (see /opt/music-platform layout — not in git)
secrets/
artifacts/*
!artifacts/.gitkeep

# Dev / AI tooling — not deployed on production VPS
.cursor/
.kiro/
.windsurf/
docs/*
!docs/AUTH_ROLLOUT_GATES.md
reports/
AGENTS.md
"Scally Milano/"
security-report.json

# Nginx logs and SSL certs
nginx/logs/*.log
nginx/ssl/*.pem
nginx/ssl/*.key
nginx/ssl/*.crt

# Backups directory contents (keep .gitkeep)
backups/*
!backups/.gitkeep

# Source music files (large)
Мне нравится/

# HAR / debug dumps (may contain tokens/cookies)
*.har
Explore-logs-*.json

