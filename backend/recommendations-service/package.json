{
  "name": "recommendations-service",
  "version": "2.0.0",
  "description": "Recommendation engine for music-platform (personalized sessions, infinite feed, feedback logging)",
  "main": "server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "glob": ">=11.1.0"
  },
  "scripts": {
    "start": "node server.js",
    "start:worker": "node workers/feedbackWorker.js",
    "start:offline": "node workers/offlineWorker.js",
    "start:all": "concurrently \"npm run start\" \"npm run start:worker\" \"npm run start:offline\"",
    "dev": "nodemon server.js",
    "dev:worker": "nodemon workers/feedbackWorker.js",
    "dev:offline": "nodemon workers/offlineWorker.js",
    "migrate": "node scripts/runMigrations.js",
    "reindex:vector": "node scripts/reindexVectorIndex.js",
    "recompute:taste": "node scripts/recomputeUserTasteClusters.js",
    "init-data": "node scripts/initializeData.js",
    "setup": "npm run migrate && npm run init-data",
    "lint": "eslint .",
    "test": "node --test tests/**/*.test.js",
    "test:coverage": "c8 node --test tests/**/*.test.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bullmq": "^5.34.8",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "lru-cache": "^11.0.2",
    "opossum": "^8.4.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "c8": "^8.0.1",
    "eslint": "^8.56.0",
    "nodemon": "^3.0.1",
    "pino-pretty": "^10.3.0"
  }
}