# Earflow Music Platform - Environment Variables Template
# 
# This is a template for environment variables required by the platform.
# Copy this file to .env and fill in the actual values.
# DO NOT commit .env with real secrets to version control.
#
# Security notes:
# - All secrets should be at least 32 characters long
# - Use different secrets for different purposes
# - Rotate secrets regularly
# - Never commit .env to git

# ============================================================================
# Database (PostgreSQL + pgvector)
# ============================================================================
DB_NAME=earflow
DB_USER=earflow
DB_PASSWORD=change_this_password_in_production
DB_CONNECTION_BUDGET=180

# Optional PgBouncer overlay (docker-compose.pgbouncer.yml)
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=1000
PGBOUNCER_DEFAULT_POOL_SIZE=50
PGBOUNCER_MIN_POOL_SIZE=5
PGBOUNCER_RESERVE_POOL_SIZE=20
PGBOUNCER_RESERVE_POOL_TIMEOUT=5
PGBOUNCER_SERVER_IDLE_TIMEOUT=60
PGBOUNCER_SERVER_LIFETIME=3600
PGBOUNCER_QUERY_TIMEOUT=0
PGBOUNCER_CLIENT_IDLE_TIMEOUT=0
# Set this URL-encoded value if DB_PASSWORD contains URL-reserved characters.
PGBOUNCER_DATABASE_URL=

# Pooled DB budgets used by docker-compose.pgbouncer.yml
DATABASE_DB_MAX_CONNECTIONS_POOLED=10
DATABASE_DB_MIN_CONNECTIONS_POOLED=1
UPLOAD_DB_MAX_CONNECTIONS_POOLED=10
UPLOAD_DB_MIN_CONNECTIONS_POOLED=1
ARTIST_DB_MAX_CONNECTIONS_POOLED=10
ARTIST_DB_MIN_CONNECTIONS_POOLED=1
RECO_DB_MAX_CONNECTIONS_POOLED=10
PLAYLIST_DB_MAX_CONNECTIONS_POOLED=10
PLAYLIST_DB_MIN_CONNECTIONS_POOLED=1
LYRICS_DB_MAX_CONNECTIONS_POOLED=10
LYRICS_DB_MIN_CONNECTIONS_POOLED=1
SUBSCRIPTION_DB_MAX_CONNECTIONS_POOLED=5
DIRECT_STREAM_DB_MAX_CONNECTIONS_POOLED=10
SEARCH_DB_MAX_CONNECTIONS_POOLED=10
SECURITY_DB_MAX_CONNECTIONS_POOLED=5
SECURITY_DB_MIN_CONNECTIONS_POOLED=0
RANKING_DB_MAX_CONNECTIONS_POOLED=5
RECO_WORKER_DB_MAX_CONNECTIONS_POOLED=5
IMPORT_DB_MAX_CONNECTIONS_POOLED=3

# ============================================================================
# Redis (Cache & Session Store)
# ============================================================================
REDIS_PASSWORD=change_this_redis_password_in_production

# ============================================================================
# Device Sync (Spotify Connect-like runtime)
# ============================================================================
DEVICE_SYNC_ENABLED=true
DEVICE_SYNC_WS_TICKET_SECRET=change_this_device_sync_ws_ticket_secret_32_chars
DEVICE_TTL_SECONDS=900
NOW_PLAYING_TTL_SECONDS=3600
MAX_DEVICES_PER_USER=30
MAX_COMMAND_PAYLOAD_BYTES=4096
TRANSFER_ACK_TIMEOUT=5s
TRANSFER_MAX_RETRIES=2
TRANSFER_IDEMPOTENCY_TTL=24h
TRANSFER_RECORD_TTL=30m
DEVICE_SYNC_TEST_ACCOUNTS=10
DEVICE_SYNC_TEST_DEVICES=5
DEVICE_SYNC_TEST_TRANSFERS=10
DEVICE_SYNC_TEST_CONCURRENCY=5
DEVICE_SYNC_TEST_TIMEOUT=2m
DEVICE_SYNC_TEST_STEP_TIMEOUT=5s

# ============================================================================
# MinIO Object Storage
# ============================================================================
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=earflow
MINIO_ROOT_PASSWORD=change_this_minio_password_in_production
MINIO_BUCKET_AUDIO=audio
MINIO_BUCKET_COVERS=covers

# ============================================================================
# JWT & Authentication
# ============================================================================
JWT_SECRET=change_this_jwt_secret_minimum_32_chars
JWT_ISSUER=earflow-auth
JWT_AUDIENCE=earflow-api
JWT_EXPIRES_IN=365d
ACCESS_JWT_EXPIRES_IN=15m
REFRESH_JWT_EXPIRES_IN=365d
ENCRYPTION_KEY=change_this_encryption_key_minimum_32_chars_hex

# SEC-005 stream tickets — disabled by default.
# Set to 1 only for controlled rollout on auth-e2e/staging (never prod until Phase 5+).
STREAM_TICKET_ENABLED=0
# Structured mint logs when enabled (Phase 2 OBSERVE). No consume/enforce.
STREAM_TICKET_OBSERVE=0
# STREAM_TICKET_ACCEPT=0   # Phase 3+ auth-e2e only; prod stays empty until staging gate
# STREAM_TICKET_ENFORCE=0  # Phase 5 auth-e2e only; legacy cookie → 401 when 1
# PROOF_ACCESS_TOKEN_ENABLED=1   # api-gateway hot-path (SEC-013); enable on prod when rolling out
# PROOF_ACCESS_TOKEN_TTL_SECONDS=90
# Frontend CRA build-time (rebuild image after change — see docs/AUTH_KIT.md):
# REACT_APP_DEVICE_PROOF_REQUIRED=1
# REACT_APP_PROOF_ACCESS_TOKEN_ENABLED=1
# REACT_APP_STREAM_TICKET_MINT_ENABLED=0
# REACT_APP_ALLOW_COOKIE_AUTH_WITHOUT_PROOF=0

# Listener SPA API base (docker frontend → /runtime-config.js → window.__EARFLOW_RUNTIME_CONFIG__.apiBaseUrl).
# Prod: leave EMPTY — browser uses https://api.earflow.ru via runtimeConfig.js fallback.
# EARFLOW_API_BASE_URL=
# Never set EARFLOW_API_BASE_URL to AUTH_E2E_BASE_URL on prod VPS.
# Auth-e2e overlay (docker-compose.auth-e2e.yml) temporarily sets http://127.0.0.1:18080 — not for prod.
# After auth-e2e / capacity / browser DoD: bash scripts/restore-prod-after-auth-e2e.sh
# Gate: npm run verify:frontend-api-base (also in verify:prod-auth-gate)

# ============================================================================
# Service Keys (Service-to-Service Authentication)
# ============================================================================
SERVICE_KEY_API_GATEWAY=change_this_api_gateway_key
SERVICE_KEY_ARTIST_API_GATEWAY=change_this_artist_api_gateway_key
SERVICE_KEY_AUTH_SERVICE=change_this_auth_service_key
SERVICE_KEY_UPLOAD_SERVICE=change_this_upload_service_key
SERVICE_KEY_TRACK_PROCESSOR=change_this_track_processor_key
SERVICE_KEY_AUDIO_FEATURES_WORKER=change_this_audio_features_worker_key
SERVICE_KEY_EBAP_HLS_ADAPTER=change_this_ebap_hls_adapter_key

# ============================================================================
# Service JWT (for database-service and other services)
# ============================================================================
SERVICE_JWT_PRIVATE_KEY_B64=base64_encoded_private_key_here
SERVICE_JWT_PUBLIC_KEY_B64=base64_encoded_public_key_here
SERVICE_JWT_ISSUER=database-service
SERVICE_JWT_AUDIENCE=database-service
SERVICE_JWT_AUDIENCE_UPLOAD=upload-service

# ============================================================================
# Media URLs
# ============================================================================
MEDIA_URL_SECRET=change_this_media_url_secret
MEDIA_URL_TTL_SECONDS=3600

# ============================================================================
# Streaming (Direct Stream & EBAP HLS)
# ============================================================================
SYSTEM_ROOT_SECRET=change_this_system_root_secret_minimum_32_chars
DIRECT_STREAM_URLTOKEN_SECRET=change_this_direct_stream_urltoken_secret
DIRECT_STREAM_URLTOKEN_SECRETS=
DIRECT_STREAM_URLTOKEN_TTL_SECONDS=900
DIRECT_STREAM_PUBLIC_ORIGIN=https://strmhaha.earflow.ru
# HLS segment CDN cache: signed /audio/v3/cache/* URLs (nginx ebap_cache + Timeweb CDN)
DIRECT_STREAM_HLS_SEGMENT_CACHE_ENABLED=true
DIRECT_STREAM_HLS_SEGMENT_CACHE_TTL_SECONDS=604800
DIRECT_STREAM_COOKIE_NAME=mp_stream
DIRECT_STREAM_COOKIE_TTL_SECONDS=1800
DIRECT_STREAM_COOKIE_DOMAIN=.earflow.ru

EBAP_TRACK_KEY_MASTER_SECRET=
EBAP_TRACK_KEY_MASTER_SECRETS=
EBAP_HLS_COOKIE_SECRET=change_this_ebap_hls_cookie_secret
EBAP_HLS_COOKIE_SECRETS=
EBAP_HLS_COOKIE_TTL_SECONDS=900
EBAP_HLS_SIGNED_URLS=
EBAP_HLS_URLTOKEN_SECRET=
EBAP_HLS_URLTOKEN_SECRETS=
EBAP_HLS_URLTOKEN_TTL_SECONDS=120
EBAP_HLS_SIGNED_URLS_ASSET_TOKEN_ONLY=
EBAP_HLS_SIGNED_URLS_PLAYLIST_TOKEN_ONLY=
EBAP_HLS_SIGNED_URLS_PLAYLIST_REQUIRE_COOKIE=
EBAP_HLS_SESSION_RL_PER_WINDOW=30
EBAP_HLS_SESSION_RL_WINDOW_SECONDS=60

EBAP_MINIO_BUCKET=ebap-cache
EBAP_HLS_MINIO_BUCKET=ebap-hls
EBAP_MANIFEST_PREFIX=manifests/
EBAP_HLS_PREFIX=hls/v1/
EBAP_S3_TIMEOUT_MS=5000
EBAP_MAX_MANIFEST_BYTES=262144
EBAP_MAX_CHUNK_BYTES=1048576
EBAP_MAX_INFLIGHT_BYTES=8388608
EBAP_HLS_MAX_TRANSCODE_JOBS=1
EBAP_HLS_LOCK_TTL_MS=600000
EBAP_HLS_WAIT_READY_MS=30000
EBAP_HLS_SEGMENT_SECONDS=4
EBAP_HLS_AAC_BITRATE_K=128
FFMPEG_BIN=ffmpeg
FFMPEG_THREADS=2

# ============================================================================
# Meilisearch (Search Engine)
# ============================================================================
MEILI_MASTER_KEY=change_this_meilisearch_key_minimum_16_chars

# ============================================================================
# Session & Security
# ============================================================================
SESSION_ENCRYPTION_KEY=
SESSION_TTL_SECONDS=31536000
COOKIE_DOMAIN=.earflow.ru
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# ============================================================================
# Security Service Settings
# ============================================================================
SECURITY_DB_MAX_CONNECTIONS=20
SECURITY_DB_MIN_CONNECTIONS=2
SECURITY_DB_PREPARE=true
SECURITY_HANDLER_TIMEOUT_MS=10000
SECURITY_STEP_UP_TTL_SECONDS=300
SECURITY_PASSWORD_WINDOW_SECONDS=60
SECURITY_PASSWORD_MAX_ATTEMPTS=5
SECURITY_STRENGTH_WINDOW_SECONDS=60
SECURITY_STRENGTH_MAX=60
SECURITY_MAX_SESSIONS=40
SECURITY_PASSWORD_MIN_LENGTH=8
SECURITY_PASSWORD_MAX_LENGTH=256
SECURITY_PBKDF_ITERATIONS=600000
SECURITY_PBKDF_ITERATIONS_LEGACY=100000
SECURITY_PBKDF_KEY_LENGTH=64
SECURITY_ENC_PBKDF_ITERATIONS=600000
SECURITY_ENC_KEY_LENGTH=32

# ============================================================================
# Database Service Settings
# ============================================================================
DATABASE_DB_MAX_CONNECTIONS=50
DATABASE_DB_MIN_CONNECTIONS=5
DATABASE_DB_IDLE_TIMEOUT_MS=30000
DATABASE_DB_CONNECTION_TIMEOUT_MS=5000
DATABASE_DB_STATEMENT_TIMEOUT_MS=30000
DATABASE_SERVICE_RATE_LIMIT_MULTIPLIER=

# ============================================================================
# Upload Service Settings
# ============================================================================
UPLOAD_DB_MAX_CONNECTIONS=30
UPLOAD_DB_MIN_CONNECTIONS=5
UPLOAD_DB_IDLE_TIMEOUT_MS=30000
UPLOAD_DB_CONNECTION_TIMEOUT_MS=5000
UPLOAD_DB_STATEMENT_TIMEOUT_MS=30000
UPLOAD_RATE_LIMIT_MULTIPLIER=
STORAGE_MODE=minio
MUSIC_SOURCE_DIR=./data/music

# ============================================================================
# Artist Service Settings
# ============================================================================
ARTIST_DB_MAX_CONNECTIONS=20
ARTIST_DB_MIN_CONNECTIONS=3
ARTIST_DB_IDLE_TIMEOUT_MS=30000
ARTIST_DB_CONNECTION_TIMEOUT_MS=5000
ARTIST_DB_STATEMENT_TIMEOUT_MS=30000
ARTIST_CLAIM_AUTO_REVIEW_ENABLED=true
ARTIST_CLAIM_AUTO_APPROVE_ENABLED=true
ARTIST_CLAIM_MIN_NOTE_LENGTH=20
ARTIST_CLAIM_AUTO_APPROVE_MIN_TRUSTED_LINKS=2
ARTIST_CLAIM_MANUAL_REVIEW_MIN_TRACKS=5
ARTIST_CLAIM_MANUAL_REVIEW_MIN_PLAYS=10000

# Service-to-service token for /internal/* endpoints (shared: artist-service ↔ artist-portal-service)
# Must be at least 32 characters. Generate with: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=change_this_internal_service_token_minimum_32_chars

# ============================================================================
# Artist Portal Settings
# ============================================================================
ARTIST_PORTAL_DISABLE_TRACK_UPLOAD_STEP_UP=false

# ============================================================================
# Direct Stream Service Database Settings
# ============================================================================
DIRECT_STREAM_DB_MAX_CONNECTIONS=10
DIRECT_STREAM_DB_IDLE_TIMEOUT_SECONDS=30
DIRECT_STREAM_DB_CONNECTION_TIMEOUT_SECONDS=5
DIRECT_STREAM_DB_PREPARE=true
DIRECT_STREAM_SESSION_CACHE_TTL_SECONDS=300

# ============================================================================
# Recommendations Service Settings
# ============================================================================
RECO_DIAGNOSTICS_ENABLED=false
RECO_ENGINE=v2
RECO_DB_MAX_CONNECTIONS=20
RECO_DB_IDLE_TIMEOUT_MS=20000
RECO_DB_CONNECTION_TIMEOUT_MS=3000
RECO_DB_STATEMENT_TIMEOUT_MS=25000
RECO_WORKER_DB_MAX_CONNECTIONS=5
RECO_WORKER_DB_PREPARE=true
RECO_CACHE_TRACKS_TTL_MS=300000
RECO_CACHE_TRACKS_MAX_SIZE=10000
RECO_DEFAULT_BATCH_SIZE=20
RECO_MAX_BATCH_SIZE=100
RECO_MAX_EXCLUDE_IDS=2000
RECO_MAX_REQUEST_EXCLUDE_IDS=2000
RECO_SESSION_TTL_SECONDS=3600
RECO_SESSION_MAX_TRACK_IDS=5000
RECO_SESSION_BOOTSTRAP_TARGET=1000
RECO_RATE_LIMIT_WINDOW_MS=60000
RECO_RATE_LIMIT_MAX=1000
RECO_RATE_LIMIT_FEEDBACK_PER_USER=200
RECO_RATE_LIMIT_API_PER_USER=300
RECO_RATE_LIMIT_SESSIONS_PER_HOUR=60
RECO_RANKING_SERVICE_URL=http://ranking-service:8080
RECO_RANKING_TIMEOUT_MS=300
RANKING_DB_MAX_CONNECTIONS=8
RANKING_DB_CONNECT_TIMEOUT_MS=1500
RANKING_DB_PREPARE=true
RECO_HOME_CACHE_TTL_SECONDS=60
RECO_HOME_CANDIDATE_LIMIT=2000
RECO_HOME_MAX_RAILS=6
RECO_HOME_MAX_PLAYLISTS=60
RECO_HOME_PLAYLISTS_PER_RAIL=10
RECO_HOME_TRACK_LIMIT=12
RECO_V2_SESSION_TTL_SECONDS=3600
RECO_V2_MAX_CANDIDATES=800
RECO_V2_EXACT_TASTE_RATIO=0.55
RECO_V2_NEAR_TASTE_RATIO=0.25
RECO_V2_DISCOVERY_RATIO=0.20
RECO_V2_VECTOR_RECENT_TRACKS=3
RECO_V2_VECTOR_LIMIT=200
RECO_V2_ONLINE_INTENT_ENABLED=true
RECO_V2_ONLINE_INTENT_LIMIT=240
RECO_V2_ONLINE_INTENT_MAX_ANCHORS=36
RECO_V2_ONLINE_INTENT_NEGATIVE_PENALTY=1.45
RECO_V2_ONLINE_INTENT_LIKE_WEIGHT=4
RECO_V2_ONLINE_INTENT_COMPLETE_WEIGHT=3.25
RECO_V2_ONLINE_INTENT_LONG_PLAY_WEIGHT=1.5
