RECO_V2_ONLINE_INTENT_SHORT_SKIP_WEIGHT=3.5
RECO_V2_ONLINE_INTENT_LATE_SKIP_WEIGHT=0.75
RECO_V2_ONLINE_INTENT_POSITIVE_PLAY_MIN_SECONDS=35
RECO_V2_ONLINE_INTENT_POSITIVE_PLAY_MIN_PROGRESS=0.55
RECO_V2_ONLINE_INTENT_LATE_SKIP_MIN_PROGRESS=0.65
RECO_V2_MOMENTUM_ENABLED=true
RECO_V2_MOMENTUM_LIMIT=80
RECO_V2_SIDESTEP_ENABLED=true
RECO_V2_SIDESTEP_LIMIT=60
RECO_V2_SIDESTEP_MIN_COS=0.50
RECO_V2_SIDESTEP_MAX_COS=0.62
RECO_V2_SIDESTEP_TARGET_COS=0.56
RECO_V2_REPULSION_ENABLED=true
RECO_V2_REPULSION_LIMIT=80
RECO_V2_REPULSION_HISTORY_TRACKS=8
RECO_V2_REPULSION_PENALTY=1.5
RECO_V2_COLLAB_NEIGHBOR_LIMIT=60
RECO_V2_COLLAB_LIMIT=150
RECO_V2_CONTEXT_LIMIT=100
RECO_V2_CONTEXT_MAX_ENERGY=0.35
RECO_V2_EXPLORATION_LIMIT=320
RECO_V2_RECENT_EXCLUDE_DAYS=14
RECO_V2_GENRE_AFFINITY_ENABLED=true
RECO_V2_GENRE_AFFINITY_LIMIT=200
RECO_V2_GENRE_AFFINITY_TOP_GENRES=5
RECO_V2_GENRE_AFFINITY_HISTORY_DAYS=90
RECO_V2_ARTIST_AFFINITY_ENABLED=true
RECO_V2_ARTIST_AFFINITY_LIMIT=120
RECO_V2_ARTIST_AFFINITY_TOP_ARTISTS=8
RECO_V2_SIMILAR_ARTIST_ENABLED=true
RECO_V2_SIMILAR_ARTIST_LIMIT=80
RECO_V2_SIMILAR_ARTIST_TOP_ARTISTS=6
RECO_V2_SKIP_BURST_THRESHOLD=3
RECO_V2_SKIP_BURST_WINDOW_SECONDS=300
RECO_V2_SEEN_TTL_SECONDS=172800
RECO_V2_BLOOM_BITS=1048576
RECO_V2_BLOOM_HASHES=7
RECO_V2_TIMEZONE_OFFSET_MINUTES=180
RECO_OFFLINE_RUN_INTERVAL_MS=900000
RECO_OFFLINE_TOP_N=1000
RECO_OFFLINE_MIN_USER_HISTORY=1
RECO_OFFLINE_REDIS_TTL_SECONDS=7200
RECO_OFFLINE_LOCK_TTL_SECONDS=600
RECO_OFFLINE_USER_BATCH_SIZE=100
RECO_OFFLINE_LOG_PROGRESS_EVERY=500
RECO_OFFLINE_HISTORY_LIMIT_MONTHS=12
RECO_OFFLINE_USE_CACHED_GLOBAL_TOP=false
RECO_OFFLINE_GLOBAL_TOP_MAX_PER_ARTIST=0
RECO_SESSION_SECRET=change_this_reco_session_secret

# ============================================================================
# Search Service Settings
# ============================================================================
LOG_LEVEL=info
SEARCH_REQUEST_TIMEOUT_MS=2500
SEARCH_PUBLIC_MAX_LIMIT=20
SEARCH_AUTHED_MAX_LIMIT=50
SEARCH_DB_MAX_CONNECTIONS=10
SEARCH_DB_PREPARE=true
SEARCH_INDEXER_ENABLED=true
SEARCH_SETUP_INDEXES=true
SEARCH_BACKFILL_ON_START=true

# Direct-DB worker budgets. Do not put LISTEN/NOTIFY workers behind
# transaction-mode PgBouncer unless they are refactored to poll.
EBAP_WORKER_DB_MAX_CONNECTIONS=6
EBAP_WORKER_DB_MIN_CONNECTIONS=1
TRANSCODE_DB_MAX_CONNECTIONS=2
# transcode-worker: 1 worker DB client + 1 LISTEN client (matches TRANSCODE_DB_MAX_CONNECTIONS)
TRANSCODE_CONCURRENCY=2
WAVEFORM_CONCURRENCY=1
TRANSCODE_SHUTDOWN_TIMEOUT_MS=120000
TRANSCODE_FAILED_MAX_RETRIES=5
TRANSCODE_FAILED_RETRY_INTERVAL_MS=3600000
TRANSCODE_FAILED_RETRY_BATCH=20
METADATA_DB_MAX_CONNECTIONS=5
IMPORT_DB_MAX_CONNECTIONS=3
EBAP_HLS_PACKAGER_DB_MAX_CONNECTIONS=10
EBAP_HLS_PACKAGER_DB_MIN_CONNECTIONS=0

# ============================================================================
# Gateway Settings
# ============================================================================
ALLOWED_SERVICES=auth-service,upload-service,api-gateway,artist-api-gateway,track-processor,recommendations-service,audio-features-worker,ebap-hls-adapter
DEBUG_AUTH=0
CLIENT_ERROR_LOG_ENABLED=false

# ============================================================================
# Frontend & Origins
# ============================================================================
NODE_ENV=production
PUBLIC_ORIGIN=https://earflow.ru
ALLOWED_ORIGINS=https://earflow.ru,https://auth.earflow.ru,https://api.earflow.ru
APP_VERSION=local
GIT_SHA=local

# ============================================================================
# Library User (for initial library)
# ============================================================================
LIBRARY_USER_ID=1

# ============================================================================
# Telegram Integration
# ============================================================================
TELEGRAM_BOT_TOKEN=

# ============================================================================
# Private Monitoring & Telegram Alerts
# ============================================================================
# Keep 127.0.0.1 by default. For phone access over Tailscale, set this to the
# server Tailscale IP, not to a public IP.
MONITORING_BIND_ADDRESS=127.0.0.1
GRAFANA_ADMIN_USER=earflow_admin
GRAFANA_ADMIN_PASSWORD=change_this_grafana_admin_password
ALERTMANAGER_EXTERNAL_URL=http://127.0.0.1:9093
# Use a dedicated alert bot token, not the public app bot token.
ALERTMANAGER_TELEGRAM_BOT_TOKEN=
ALERTMANAGER_TELEGRAM_CHAT_ID=
TELEGRAM_OPS_BOT_TOKEN=
TELEGRAM_OPS_BOOTSTRAP_SECRET=
TELEGRAM_OPS_ALLOWED_USER_IDS=
TELEGRAM_OPS_ALLOWED_CHAT_IDS=
TELEGRAM_OPS_ALLOW_GROUPS=false
TELEGRAM_OPS_ALLOW_MULTIPLE_CLAIMS=false
TELEGRAM_OPS_SEND_RESOLVED=true
TELEGRAM_OPS_DELETE_WEBHOOK=true
# Override only if the default postgres:5432/${DB_NAME}?sslmode=disable is not valid.
POSTGRES_EXPORTER_DATA_SOURCE_URI=
# Required only when enabling the pgbouncer-metrics compose profile.
PGBOUNCER_EXPORTER_CONNECTION_STRING=

# ============================================================================
# OpenTelemetry (Optional)
# ============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.2

# ============================================================================
# Load Testing (Optional)
# ============================================================================
LOAD_TEST_MODE=false
LOAD_TEST_RATE_LIMIT_MULTIPLIER=

# ============================================================================
# Integration Tests (Optional)
# ============================================================================
IT_ORIGIN=https://earflow.ru
IT_TRACK_READY_ID=
IT_TRACK_NOT_READY_ID=
IT_TEST_USER_ID=1
IT_HLS_SIGNED_URLS=
IT_HLS_URLTOKEN_TTL_SECONDS=120
IT_HLS_ASSET_TOKEN_ONLY=

# ============================================================================
# Auth full-stack e2e (PEND-SEC-001 — server/CI only, see docs/AUTH_FULLSTACK_E2E_RUNBOOK.md)
# ============================================================================
AUTH_E2E_BASE_URL=http://127.0.0.1:18080
AUTH_E2E_ORIGIN=http://127.0.0.1:18080
AUTH_E2E_HOST_PORT=18080
AUTH_E2E_EMAIL=pop-e2e@earflow.test
AUTH_E2E_PASSWORD=PopE2eTest1
AUTH_E2E_ALLOWED_ORIGINS=http://127.0.0.1:18080,http://localhost:18080,http://auth-e2e-edge:8080
# Auth e2e overlay on api-gateway (http://127.0.0.1). Required: COOKIE_DOMAIN=host — empty + production => .earflow.ru
# AUTH_E2E_COOKIE_DOMAIN=host
# AUTH_E2E_COOKIE_SECURE=false
# AUTH_E2E_COOKIE_SAMESITE=Lax
# SEC-005 Phase 4 staging only — auth-e2e overlay rebuilds frontend with mint=1
# AUTH_E2E_STREAM_TICKET_MINT_ENABLED=1

# PEND-SEC-011 Postgres auth SoT (security-service): off | dual_write | pg_read | pg_only
AUTH_PG_SOT_MODE=off

# ============================================================================
# Auth capacity (PEND-SEC-CAPACITY-001 — staging/VPS only, NOT prod user traffic)
# ============================================================================
# CAPACITY_BASE_URL=http://127.0.0.1:18080
# CAPACITY_ORIGIN=http://127.0.0.1:18080
# CAPACITY_SESSION_COUNT=20
# CAPACITY_HOT_RPS=500
# CAPACITY_HOT_DURATION=60s
# CAPACITY_HOT_VUS=50
# CAPACITY_HOT_P95_MS=50
# CAPACITY_GATEWAY_REPLICAS=2
# CAPACITY_SKIP_STACK=1
# CAPACITY_LOAD_TEST_MODE=true
# CAPACITY_RATE_LIMIT_MULTIPLIER=50

# ============================================================================
# Cache Settings
# ============================================================================
PROFILE_CACHE_TTL_SECONDS=600
