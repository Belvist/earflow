{
    "name": "earflow-artist-frontend",
    "version": "1.0.0",
    "private": true,
    "description": "Earflow Artist Portal frontend",
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "start": "react-scripts start",
        "build": "cross-env GENERATE_SOURCEMAP=false CI=true react-scripts build",
        "lint": "eslint src/"
    },
    "dependencies": {
        "framer-motion": "11.15.0",
        "qrcode.react": "4.2.0",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "react-easy-crop": "5.0.5",
        "react-icons": "5.4.0",
        "react-router-dom": "7.1.1",
        "react-scripts": "5.0.1",
        "styled-components": "6.1.14"
    },
    "devDependencies": {
        "@types/react": "18.3.27",
        "@types/react-dom": "18.3.7",
        "cross-env": "7.0.3",
        "typescript": "4.9.5"
    },
    "eslintConfig": {
        "extends": [
            "react-app",
            "react-app/jest"
        ],
        "rules": {
            "react/prop-types": "off"
        }
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}